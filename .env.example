# MoodMix 鐜閰嶇疆鏂囦欢
# 澶嶅埗鏈枃浠朵负 .env 骞跺～鍏ヤ綘鑷繁鐨?API Key
# cp .env.example .env

# LLM 閰嶇疆
# SiliconFlow API Key - 鍦?https://docs.siliconflow.cn/ 鑾峰彇
SILICONFLOW_API_KEY=your_key_here
SILICONFLOW_MODEL_8B=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_MODEL_30B=Qwen/Qwen2.5-32B-Instruct

# 鏈嶅姟鍣ㄩ厤缃?NODE_ENV=development
PROXY_PORT=3001

# Webpack 寮€鍙戞湇鍔″櫒閰嶇疆
HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true
PUBLIC_URL=/
BROWSER=none
